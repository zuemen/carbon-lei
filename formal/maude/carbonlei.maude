*** CarbonLEI protocol model in rewriting logic (Maude 3.5.1).
***
*** A bounded, abstract model of the CarbonLEI protocol: the allowlist (bodies, auditors,
*** suspension), the off-chain ECR revocation in KERI, the watcher that mirrors it on-chain,
*** registration and the tonnage ledger of EmissionsClaimRegistry, claims, and the verdict of
*** the SDK verifier (checks 4, 5 and 7, with the CONTESTED window of check 4).
***
*** Cryptography is assumed perfect: nobody can forge a credential, an EIP-712 signature or a KEL
*** anchor, so checks 1-3 and 6 pass for every genuine object and the attacker can only re-use,
*** re-present, mis-register or mis-quantify genuine objects (Dolev-Yao without key compromise,
*** except the stolen allowlist owner key of attack 4, modelled as an impostor body on the allowlist).
*** Time is discretised into ticks; delta is both the CONTESTED window and the watcher's sync bound
*** of assumption A-Watch, in ticks.
***
*** See formal/maude/README.md and docs/SECURITY.md §9.3 for what is modelled, what is not, and
*** the results. This is a bounded model check of an abstract model, not a proof that the protocol
*** or the code is secure.

load model-checker

fmod CARBONLEI-DATA is
  protecting NAT .
  sorts Body Auditor Report OptReport Importer Root Slot WMode Ev Verdict Mutant .
  subsort Report < OptReport .
  ops b1 b2 : -> Body [ctor] .
  ops a1 a2 : -> Auditor [ctor] .
  ops r1 r2 : -> Report [ctor] .
  op noRep : -> OptReport [ctor] .
  ops i1 i2 : -> Importer [ctor] .
  *** root of the body's vLEI chain: the pinned root, or another root (attack 4)
  ops pinned other : -> Root [ctor] .
  *** ledger slots: the pair (reportScopeKey, credScopeKey) collapsed to one label
  ops X Y Z : -> Slot [ctor] .
  *** watcher: up = syncs within delta (A-Watch); late = syncs at any later time or never; down = never
  ops up late down : -> WMode [ctor] .
  *** evidence: the supplier includes the ECR's anchored TEL revocation, or leaves it out
  ops withRev noRev : -> Ev [ctor] .
  ops VALID CONTESTED INVALID : -> Verdict [ctor] .
  *** mutants: each removes or weakens one guard of the contract or one check of the verifier
  *** (README "Mutants" lists them with the check that catches each)
  ops noClaimCap noOverClaimed noCovered noAuthGuard noSuspGuard noExpiryGuard noIssuerGuard : -> Mutant [ctor] .
  ops noCheck5 noRoot noScope noContested winLeftOpen winRightOpen noEvidenceRev noSupersede : -> Mutant [ctor] .
endfm

mod CARBONLEI is
  protecting CARBONLEI-DATA .
  sorts Fact Conf Sys Acc AccSet .
  subsort Fact < Conf .
  subsort Acc < AccSet .
  op empty : -> Conf [ctor] .
  op __ : Conf Conf -> Conf [ctor assoc comm id: empty] .
  op {_} : Conf -> Sys [ctor] .
  *** ac(r, i, q): importer i accepted (VALID or CONTESTED) a proof of this batch attached to
  *** credential r and stating quantity q
  op ac : Report Importer Nat -> Acc [ctor] .
  op noAcc : -> AccSet [ctor] .
  op _;_ : AccSet AccSet -> AccSet [ctor assoc comm id: noAcc] .

  *** --- environment and parameters
  op clock : Nat -> Fact [ctor] .
  op tmax : Nat -> Fact [ctor] .
  op delta : Nat -> Fact [ctor] .
  op wmode : WMode -> Fact [ctor] .
  op mut : Mutant -> Fact [ctor] .
  *** one-shot permissions for the environment's actions
  op allowSuspend : Body -> Fact [ctor] .
  op allowLift : Body -> Fact [ctor] .
  op allowKeri : Auditor -> Fact [ctor] .
  *** claim times are recorded only where check 4 can use them (supersession); elsewhere 0
  op claimTimes : -> Fact [ctor] .
  op slotLabel : Slot -> Fact [ctor] .
  *** the slot labels a registrant may name for a credential (its true slot, or another one: T19 (8))
  op canReg : Report Slot -> Fact [ctor] .
  op importer : Importer -> Fact [ctor] .
  *** --- allowlist (VerifierAllowlist); every entry added at time 0
  *** body(b, root of its vLEI chain, accreditedUntil)
  op body : Body Root Nat -> Fact [ctor] .
  op aud : Auditor Body -> Fact [ctor] .
  op susp : Body Nat -> Fact [ctor] .
  op lifted : Body Nat -> Fact [ctor] .
  *** allowlist revokedAt: block time of the watcher's revokeAuditor, not the KERI time
  op chainRev : Auditor Nat -> Fact [ctor] .
  *** --- KERI (off-chain truth): the body revoked the auditor's ECR at time n
  op keriRev : Auditor Nat -> Fact [ctor] .
  *** the watcher's queue: a KERI revocation (time n) not yet mirrored on-chain
  op pend : Auditor Nat -> Fact [ctor] .
  *** --- credentials signed by a body's key and anchored by its auditor
  *** cred(r, body, auditor, verifiedKg, true slot from the signed fields, supersedes)
  op cred : Report Body Auditor Nat Slot OptReport -> Fact [ctor] .
  *** --- EmissionsClaimRegistry
  *** reg(r, registeredAt, slot label it was registered under,
  ***     ghost: auditor's ECR already revoked in KERI, ghost: already revoked on the allowlist)
  op reg : Report Nat Slot Bool Bool -> Fact [ctor] .
  *** slot(label, latest credential, cumulative claimedKg)
  op slot : Slot Report Nat -> Fact [ctor] .
  op supBy : Report Report Nat -> Fact [ctor] .
  *** an unclaimed batch of q tonnes (batches are anonymous: symmetric, so not named)
  op ship : Nat -> Fact [ctor] .
  *** claimed(report, importer, quantity, claimedAt, the proofs of this batch accepted so far)
  op claimed : Report Importer Nat Nat AccSet -> Fact [ctor] .
  *** --- ghosts for the properties, written at registration by the spec functions (below), not by
  *** the guards: gReg(r, the body was suspended or past its accreditation at that moment);
  *** gRev(r, r revised a credential of another body while that body was active)
  op gReg : Report Bool -> Fact [ctor] .
  op gRev : Report Bool -> Fact [ctor] .

  vars S ST : Conf . vars N M K T T' E Q Q0 Q' V C D TR T2 : Nat .
  vars B B' : Body . vars A A' : Auditor . vars R R' R0 : Report . var O : OptReport .
  vars L P : Slot . var W : WMode . vars I I0 I' : Importer .
  var Rt : Root . vars F1 F2 F3 : Bool . var EV : Ev . var Mu : Mutant . vars AS AS' AS'' : AccSet .

  *** ------------------------------------------------------------ state queries
  op mutant : Mutant Conf -> Bool .
  eq mutant(Mu, mut(Mu) S) = true .
  eq mutant(Mu, S) = false [owise] .

  op now : Conf -> Nat .
  eq now(clock(N) S) = N .
  op dlt : Conf -> Nat .
  eq dlt(delta(D) S) = D .
  op claimTime : Conf -> Nat .
  eq claimTime(claimTimes clock(N) S) = N .
  eq claimTime(S) = 0 [owise] .

  op keriRevoked : Auditor Conf -> Bool .
  eq keriRevoked(A, keriRev(A, N) S) = true .
  eq keriRevoked(A, S) = false [owise] .
  op chainRevoked : Auditor Conf -> Bool .
  eq chainRevoked(A, chainRev(A, N) S) = true .
  eq chainRevoked(A, S) = false [owise] .
  op hasSusp : Body Conf -> Bool .
  eq hasSusp(B, susp(B, N) S) = true .
  eq hasSusp(B, S) = false [owise] .
  op hasLift : Body Conf -> Bool .
  eq hasLift(B, lifted(B, N) S) = true .
  eq hasLift(B, S) = false [owise] .

  *** contract view at the current time: isInstitutionActiveAt(now), latest suspension interval
  op activeNow : Body Nat Conf -> Bool .
  eq activeNow(B, N, body(B, Rt, T) S) =
     (N <= T or mutant(noExpiryGuard, S))
     and (not hasSusp(B, S) or hasLift(B, S) or mutant(noSuspGuard, S)) .
  eq activeNow(B, N, S) = false [owise] .
  *** isAuthorizedAt(now): the auditor is listed under the body and not revoked on the allowlist
  op audAuthNow : Auditor Body Conf -> Bool .
  eq audAuthNow(A, B, aud(A, B) S) = mutant(noAuthGuard, S) or not chainRevoked(A, S) .
  eq audAuthNow(A, B, S) = false [owise] .

  op isReg : Report Conf -> Bool .
  eq isReg(R, reg(R, N, L, F1, F2) S) = true .
  eq isReg(R, S) = false [owise] .
  op regTime : Report Conf -> Nat .
  eq regTime(R, reg(R, N, L, F1, F2) S) = N .
  op regSlot : Report Conf -> Slot .
  eq regSlot(R, reg(R, N, L, F1, F2) S) = L .
  op hasSlot : Slot Conf -> Bool .
  eq hasSlot(L, slot(L, R, C) S) = true .
  eq hasSlot(L, S) = false [owise] .

  op bodyOf : Report Conf -> Body .
  eq bodyOf(R, cred(R, B, A, V, P, O) S) = B .
  op audOf : Report Conf -> Auditor .
  eq audOf(R, cred(R, B, A, V, P, O) S) = A .
  op vkg : Report Conf -> Nat .
  eq vkg(R, cred(R, B, A, V, P, O) S) = V .
  op trueSlot : Report Conf -> Slot .
  eq trueSlot(R, cred(R, B, A, V, P, O) S) = P .
  op rootOf : Body Conf -> Root .
  eq rootOf(B, body(B, Rt, T) S) = Rt .
  op accUntil : Body Conf -> Nat .
  eq accUntil(B, body(B, Rt, T) S) = T .

  *** ------------------------------------------------------------ rules
  *** time advances; with a watcher that is up, not past an unsynced revocation's deadline (A-Watch)
  crl [tick] : { clock(N) tmax(M) S } => { clock(s N) tmax(M) S }
    if N < M /\ noOverdue(N, S) .
  op noOverdue : Nat Conf -> Bool .
  eq noOverdue(N, wmode(up) delta(D) pend(A, K) S) =
     N < K + D and noOverdue(N, wmode(up) delta(D) S) .
  eq noOverdue(N, S) = true [owise] .

  *** the body revokes its auditor's ECR in KERI (the auditor leaves); the auditor keeps its KERI keys,
  *** so it can still anchor a credential (check 6 passes)
  rl [keri-revoke] : { allowKeri(A) clock(N) S } => { clock(N) S keriRev(A, N) pend(A, N) } .

  *** the watcher mirrors it with revokeAuditor
  crl [watcher-sync] : { pend(A, K) wmode(W) clock(N) S } => { wmode(W) clock(N) S chainRev(A, N) }
    if W =/= down .

  *** suspendVerifier / liftSuspension, sent by hand with the watcher key
  rl [suspend] : { allowSuspend(B) clock(N) S } => { clock(N) S susp(B, N) } .
  crl [lift] : { allowLift(B) clock(N) S } => { clock(N) S lifted(B, N) } if hasSusp(B, S) .

  *** registerReport into an empty slot (branch a); the registrant names the slot label
  crl [register-new] :
    { cred(R, B, A, V, P, noRep) canReg(R, L) clock(N) S }
    => { cred(R, B, A, V, P, noRep) canReg(R, L) clock(N) S
         reg(R, N, L, sKeriRevokedNow(A, S), sChainRevokedNow(A, S)) slot(L, R, 0)
         gReg(R, sInactiveAt(B, N, S)) }
    if not isReg(R, S) /\ activeNow(B, N, S) /\ audAuthNow(A, B, S)
       /\ (not hasSlot(L, S) or mutant(noCovered, S)) .

  *** registerReport revising the slot's latest credential (branch b): another body only while the
  *** original issuer is not active (NotReportIssuer); claimedKg carries over and must be covered
  *** (SupersedeOverClaimed)
  crl [register-revise] :
    { cred(R, B, A, V, P, R') slot(L, R', C) clock(N) S }
    => { cred(R, B, A, V, P, R') slot(L, R, C) clock(N) S
         reg(R, N, L, sKeriRevokedNow(A, S), sChainRevokedNow(A, S)) supBy(R', R, N)
         gReg(R, sInactiveAt(B, N, S))
         gRev(R, sBody(R', S) =/= B and not sInactiveAt(sBody(R', S), N, S)) }
    if not isReg(R, S) /\ activeNow(B, N, S) /\ audAuthNow(A, B, S)
       /\ (V >= C or mutant(noOverClaimed, S))
       /\ (bodyOf(R', S) == B or not activeNow(bodyOf(R', S), N, S) or mutant(noIssuerGuard, S)) .

  *** claimShipment by the supplier, against a slot's latest credential, declared to any importer
  crl [claim] :
    { ship(Q) slot(L, R, C) importer(I) S }
    => { slot(L, R, C + Q) importer(I) S claimed(R, I, Q, claimTime(S), noAcc) }
    if C + Q <= vkg(R, S) or mutant(noClaimCap, S) .

  *** Acceptance ghost. An importer may verify any proof at any time: a claimed batch attached to ANY
  *** credential R (Dolev-Yao re-use), presented to ANY importer I (replay to another importer), stating
  *** the claimed quantity or one more (over-claim); the supplier leaves revocations out of the evidence.
  *** Rather than one interleaving per verification, every reached state is closed under acceptance:
  *** each proof the verifier would accept (VALID or CONTESTED) there is recorded in the batch's AccSet.
  *** So the AccSets hold exactly the proofs accepted by some importer at some reached state.
  ceq { claimed(R0, I0, Q0, T, AS) cred(R, B, A, V, P, O) importer(I) S }
    = { claimed(R0, I0, Q0, T, AS ; ac(R, I, Q0)) cred(R, B, A, V, P, O) importer(I) S }
    if not inAcc(ac(R, I, Q0), AS)
       /\ verdictShip(R, I, Q0, noRev, R0, I0, Q0, T,
            claimed(R0, I0, Q0, T, AS) cred(R, B, A, V, P, O) importer(I) S) =/= INVALID .
  ceq { claimed(R0, I0, Q0, T, AS) cred(R, B, A, V, P, O) importer(I) S }
    = { claimed(R0, I0, Q0, T, AS ; ac(R, I, s Q0)) cred(R, B, A, V, P, O) importer(I) S }
    if not inAcc(ac(R, I, s Q0), AS)
       /\ verdictShip(R, I, s Q0, noRev, R0, I0, Q0, T,
            claimed(R0, I0, Q0, T, AS) cred(R, B, A, V, P, O) importer(I) S) =/= INVALID .
  op inAcc : Acc AccSet -> Bool .
  eq inAcc(ac(R, I, Q), ac(R, I, Q) ; AS) = true .
  eq inAcc(ac(R, I, Q), AS) = false [owise] .

  *** ------------------------------------------------------------ the verifier (sdk/verify.ts)
  *** A proof of a batch: credential R, presented to importer I, stating quantity Q; the batch was
  *** claimed against R0 for I0 with Q0 at T. Checks 4, 5 and 7; checks 1-3 and 6 pass (perfect crypto).
  op verdictShip : Report Importer Nat Ev Report Importer Nat Nat Conf -> Verdict .
  eq verdictShip(R, I, Q, EV, R0, I0, Q0, T, ST) =
     if not isReg(R, ST) then INVALID
     else if check4fail(R, (if R == R0 and I == I0 then T else now(ST) fi), R == R0 and I == I0, ST)
             or check5fail(R, I, Q, R0, I0, Q0, ST) or check7fail(R, EV, ST) then INVALID
     else if contested(R, ST) then CONTESTED else VALID fi fi fi .
  *** a proof without a shipment (check 5 skipped; check 4 judged at the latest block)
  op verdictCred : Report Ev Conf -> Verdict .
  eq verdictCred(R, EV, ST) =
     if not isReg(R, ST) then INVALID
     else if check4fail(R, now(ST), false, ST) or check7fail(R, EV, ST) then INVALID
     else if contested(R, ST) then CONTESTED else VALID fi fi fi .

  *** check 4: scope keys (4j) and supersession at t (4d). t is the claim time only for the importer
  *** the batch was declared to (boundToVerifier), else the latest block; the same-block exception
  *** keeps a batch claimed in the block of the revision valid for its importer.
  op check4fail : Report Nat Bool Conf -> Bool .
  eq check4fail(R, T, F1, ST) =
     (regSlot(R, ST) =/= trueSlot(R, ST) and not mutant(noScope, ST))
     or (supersededAt(R, T, F1, ST) and not mutant(noSupersede, ST)) .
  op supersededAt : Report Nat Bool Conf -> Bool .
  eq supersededAt(R, T, F1, supBy(R, R', T2) S) = T >= T2 and not (F1 and T2 == T) .
  eq supersededAt(R, T, F1, S) = false [owise] .

  *** check 5: the batch was claimed against this credential, for this importer, with this quantity
  op check5fail : Report Importer Nat Report Importer Nat Conf -> Bool .
  eq check5fail(R, I, Q, R0, I0, Q0, ST) =
     not (R == R0 and I == I0 and Q == Q0) and not mutant(noCheck5, ST) .

  *** check 7: chain under the pinned root; allowlist at registration (revokedAt < registeredAt fails,
  *** registeredAt > accreditedUntil fails); an anchored ECR revocation in the evidence dated before
  *** registration fails (one dated in the same second or later is only noted)
  op check7fail : Report Ev Conf -> Bool .
  eq check7fail(R, EV, ST) =
     (rootOf(bodyOf(R, ST), ST) =/= pinned and not mutant(noRoot, ST))
     or allowlistRevokedBefore(audOf(R, ST), regTime(R, ST), ST)
     or regTime(R, ST) > accUntil(bodyOf(R, ST), ST)
     or (EV == withRev and evidenceRevokedBefore(audOf(R, ST), regTime(R, ST), ST)
         and not mutant(noEvidenceRev, ST)) .
  op allowlistRevokedBefore : Auditor Nat Conf -> Bool .
  eq allowlistRevokedBefore(A, TR, chainRev(A, E) S) = E < TR .
  eq allowlistRevokedBefore(A, TR, S) = false [owise] .
  op evidenceRevokedBefore : Auditor Nat Conf -> Bool .
  eq evidenceRevokedBefore(A, TR, keriRev(A, K) S) = K < TR .
  eq evidenceRevokedBefore(A, TR, S) = false [owise] .

  *** check 4l: CONTESTED if the auditor was revoked (on the allowlist) or the body suspended in
  *** [registeredAt, registeredAt + delta], as seen at the latest block
  op contested : Report Conf -> Bool .
  eq contested(R, ST) =
     not mutant(noContested, ST) and
     (inWindow(chainTime(audOf(R, ST), ST), regTime(R, ST), dlt(ST), ST)
      or inWindow(suspTime(bodyOf(R, ST), ST), regTime(R, ST), dlt(ST), ST)) .
  *** event times shifted by one: 0 = no event
  op chainTime : Auditor Conf -> Nat .
  eq chainTime(A, chainRev(A, E) S) = s E .
  eq chainTime(A, S) = 0 [owise] .
  op suspTime : Body Conf -> Nat .
  eq suspTime(B, susp(B, E) S) = s E .
  eq suspTime(B, S) = 0 [owise] .
  op inWindow : Nat Nat Nat Conf -> Bool .
  eq inWindow(0, TR, D, ST) = false .
  eq inWindow(s E, TR, D, ST) =
     (if mutant(winLeftOpen, ST) then TR < E else TR <= E fi)
     and (if mutant(winRightOpen, ST) then E < TR + D else E <= TR + D fi) .

  *** ------------------------------------------------------------ specification side
  *** The properties below are stated from the specification (SECURITY §3, §4 and §9; the contract's
  *** NatSpec; the verdict rules of sdk/verify.ts) with their own helper functions, all prefixed s.
  *** They call no helper of the rules or of the verifier above, so a mutation of a guard or of a
  *** verifier helper does not change the property with it. The only functions of the model they use
  *** are the verdicts verdictShip and verdictCred themselves, the system under test.
  op sNow : Conf -> Nat .
  eq sNow(clock(N) S) = N .
  op sDelta : Conf -> Nat .
  eq sDelta(delta(D) S) = D .
  *** the signed fields of a credential
  op sKg : Report Conf -> Nat .
  eq sKg(R, cred(R, B, A, V, P, O) S) = V .
  op sSlot : Report Conf -> Slot .
  eq sSlot(R, cred(R, B, A, V, P, O) S) = P .
  op sBody : Report Conf -> Body .
  eq sBody(R, cred(R, B, A, V, P, O) S) = B .
  op sAud : Report Conf -> Auditor .
  eq sAud(R, cred(R, B, A, V, P, O) S) = A .
  op sRoot : Body Conf -> Root .
  eq sRoot(B, body(B, Rt, T) S) = Rt .
  *** the status at the moment a rule fires (used only to write the ghosts of reg, gReg and gRev)
  op sKeriRevokedNow : Auditor Conf -> Bool .
  eq sKeriRevokedNow(A, keriRev(A, K) S) = true .
  eq sKeriRevokedNow(A, S) = false [owise] .
  op sChainRevokedNow : Auditor Conf -> Bool .
  eq sChainRevokedNow(A, chainRev(A, E) S) = true .
  eq sChainRevokedNow(A, S) = false [owise] .
  *** P3: a body is not active at time N if N is after its accreditedUntil, or it was suspended
  *** and the suspension has not been lifted (one suspension per body); not listed = not active
  op sInactiveAt : Body Nat Conf -> Bool .
  eq sInactiveAt(B, N, body(B, Rt, T) S) = T < N or sSuspendedUnlifted(B, S) .
  eq sInactiveAt(B, N, S) = true [owise] .
  op sSuspendedUnlifted : Body Conf -> Bool .
  eq sSuspendedUnlifted(B, susp(B, E) S) = not sLifted(B, S) .
  eq sSuspendedUnlifted(B, S) = false [owise] .
  op sLifted : Body Conf -> Bool .
  eq sLifted(B, lifted(B, K) S) = true .
  eq sLifted(B, S) = false [owise] .
  *** an allowlist event against a credential (its auditor revoked on-chain, or its body suspended)
  *** at a tick in [lo, hi]
  op sEventIn : Auditor Body Nat Nat Conf -> Bool .
  eq sEventIn(A, B, M, K, chainRev(A, E) S) = (M <= E and E <= K) or sEventIn(A, B, M, K, S) .
  eq sEventIn(A, B, M, K, susp(B, E) S) = (M <= E and E <= K) or sEventIn(A, B, M, K, S) .
  eq sEventIn(A, B, M, K, S) = false [owise] .
  *** the ECR revocation in KERI: its time, and whether it is dated before tick N
  op sKeriTime : Auditor Conf -> Nat .
  eq sKeriTime(A, keriRev(A, K) S) = K .
  op sKeriBefore : Auditor Nat Conf -> Bool .
  eq sKeriBefore(A, N, keriRev(A, K) S) = K < N .
  eq sKeriBefore(A, N, S) = false [owise] .
  *** some importer would accept the credential as VALID at the latest block: alone, or with a batch
  *** claimed against any credential, shown to the importer it was declared to
  op sAnyValid : Report Conf -> Bool .
  eq sAnyValid(R, ST) = verdictCred(R, noRev, ST) == VALID or sAnyValidShip(R, ST, ST) .
  op sAnyValidShip : Report Conf Conf -> Bool .
  eq sAnyValidShip(R, claimed(R0, I0, Q0, T, AS) S, ST) =
     verdictShip(R, I0, Q0, noRev, R0, I0, Q0, T, ST) == VALID or sAnyValidShip(R, S, ST) .
  eq sAnyValidShip(R, S, ST) = false [owise] .

  *** ------------------------------------------------------------ properties (bad-state predicates)
  *** P1 on-chain: every slot's claimedKg is at most verifiedKg of its latest credential
  op p1Bad : Conf -> Bool .
  eq p1Bad(ST) = p1BadL(ST, ST) .
  op p1BadL : Conf Conf -> Bool .
  eq p1BadL(slot(L, R, C) S, ST) = C > sKg(R, ST) or p1BadL(S, ST) .
  eq p1BadL(S, ST) = false [owise] .

  *** LEDGER: for a product (true slot), the tonnes accepted by importers, summed over every batch,
  *** every importer and every accepted proof, exceed verifiedKg of the latest credential registered
  *** under that slot (0 if none)
  op ledgerBad : Conf -> Bool .
  eq ledgerBad(ST) = ledgerBadL(ST, ST) .
  op ledgerBadL : Conf Conf -> Bool .
  eq ledgerBadL(slotLabel(L) S, ST) = accSum(L, ST, ST) > capOf(L, ST) or ledgerBadL(S, ST) .
  eq ledgerBadL(S, ST) = false [owise] .
  op accSum : Slot Conf Conf -> Nat .
  eq accSum(L, claimed(R0, I0, Q0, T, AS) S, ST) = accSumA(L, AS, ST) + accSum(L, S, ST) .
  eq accSum(L, S, ST) = 0 [owise] .
  op accSumA : Slot AccSet Conf -> Nat .
  eq accSumA(L, ac(R, I, Q) ; AS, ST) = (if sSlot(R, ST) == L then Q else 0 fi) + accSumA(L, AS, ST) .
  eq accSumA(L, noAcc, ST) = 0 .
  *** the cap: verifiedKg of the latest credential of a slot under that label (the largest, if a
  *** mutant lets one label hold two slots)
  op capOf : Slot Conf -> Nat .
  eq capOf(L, slot(L, R, C) S) = max(sKg(R, slot(L, R, C) S), capOf(L, S)) .
  eq capOf(L, S) = 0 [owise] .

  *** ON-CHAIN SUM per product across slots (T19 (8)): claims summed over every slot holding a
  *** credential of that product exceed the largest verifiedKg signed for that product
  op onchainSumBad : Conf -> Bool .
  eq onchainSumBad(ST) = onchainSumBadL(ST, ST) .
  op onchainSumBadL : Conf Conf -> Bool .
  eq onchainSumBadL(slotLabel(L) S, ST) = claimSum(L, ST, ST) > maxSigned(L, ST) or onchainSumBadL(S, ST) .
  eq onchainSumBadL(S, ST) = false [owise] .
  op maxSigned : Slot Conf -> Nat .
  eq maxSigned(L, cred(R, B, A, V, P, O) S) = if P == L then max(V, maxSigned(L, S)) else maxSigned(L, S) fi .
  eq maxSigned(L, S) = 0 [owise] .
  op claimSum : Slot Conf Conf -> Nat .
  eq claimSum(L, claimed(R, I, Q, T, AS) S, ST) = (if sSlot(R, ST) == L then Q else 0 fi) + claimSum(L, S, ST) .
  eq claimSum(L, S, ST) = 0 [owise] .

  *** REPLAY: one batch accepted by two different importers
  op replayBad : Conf -> Bool .
  ceq replayBad(claimed(R0, I0, Q0, T, ac(R, I, Q) ; ac(R', I', Q') ; AS) S) = true if I =/= I' .
  eq replayBad(S) = false [owise] .

  *** AUTH (P3, T1, attack 4): an accepted proof whose credential was not registered, or was
  *** registered with an auditor already revoked on the allowlist, or by a body that was suspended or
  *** past its accreditation at that moment, or by a body outside the pinned root
  op authBad : Conf -> Bool .
  eq authBad(ST) = authBadL(ST, ST) .
  op authBadL : Conf Conf -> Bool .
  eq authBadL(claimed(R0, I0, Q0, T, AS) S, ST) = authBadA(AS, ST) or authBadL(S, ST) .
  eq authBadL(S, ST) = false [owise] .
  op authBadA : AccSet Conf -> Bool .
  eq authBadA(ac(R, I, Q) ; AS, ST) = authBad1(R, ST, ST) or authBadA(AS, ST) .
  eq authBadA(noAcc, ST) = false .
  op authBad1 : Report Conf Conf -> Bool .
  eq authBad1(R, reg(R, N, L, F1, F2) gReg(R, F3) S, ST) = F2 or F3 or sRoot(sBody(R, ST), ST) =/= pinned .
  eq authBad1(R, S, ST) = true [owise] .

  *** REG-AFTER-REVOCATION: a registration with an auditor already revoked on the allowlist (P3, P6)
  op regAfterRevBad : Conf -> Bool .
  eq regAfterRevBad(reg(R, N, L, F1, true) S) = true .
  eq regAfterRevBad(S) = false [owise] .

  *** REG-INACTIVE (P3): a registration by a body that was suspended (and not lifted) or past its
  *** accreditation at the registration block
  op regInactiveBad : Conf -> Bool .
  eq regInactiveBad(gReg(R, true) S) = true .
  eq regInactiveBad(S) = false [owise] .

  *** FOREIGN-REVISION (NotReportIssuer, T19 (d)): a credential superseded by a revision that another
  *** body registered while the first body was active
  op foreignReviseBad : Conf -> Bool .
  eq foreignReviseBad(gRev(R, true) S) = true .
  eq foreignReviseBad(S) = false [owise] .

  *** EVIDENCE: a credential whose proof carries an anchored ECR revocation dated before its
  *** registration is not INVALID
  op evidenceBad : Conf -> Bool .
  eq evidenceBad(ST) = evidenceBadL(ST, ST) .
  op evidenceBadL : Conf Conf -> Bool .
  eq evidenceBadL(reg(R, N, L, F1, F2) S, ST) =
     (sKeriBefore(sAud(R, ST), N, ST) and verdictCred(R, withRev, ST) =/= INVALID)
     or evidenceBadL(S, ST) .
  eq evidenceBadL(S, ST) = false [owise] .

  *** WINDOW: a credential whose auditor was revoked on the allowlist, or whose body was suspended,
  *** at a tick in [registeredAt, registeredAt + delta] is VALID (alone, or with a batch shown to the
  *** importer it was declared to)
  op windowBad : Conf -> Bool .
  eq windowBad(ST) = windowBadL(ST, ST) .
  op windowBadL : Conf Conf -> Bool .
  eq windowBadL(reg(R, N, L, F1, F2) S, ST) =
     (sEventIn(sAud(R, ST), sBody(R, ST), N, N + sDelta(ST), ST) and sAnyValid(R, ST))
     or windowBadL(S, ST) .
  eq windowBadL(S, ST) = false [owise] .

  *** KERI: VALID for a credential registered after its auditor's ECR was revoked in KERI, once the
  *** watcher's deadline (KERI time + delta, A-Watch) has passed
  op keriBad : Conf -> Bool .
  eq keriBad(ST) = keriBadL(ST, ST) .
  op keriBadL : Conf Conf -> Bool .
  eq keriBadL(reg(R, N, L, true, F2) S, ST) =
     (sNow(ST) > sKeriTime(sAud(R, ST), ST) + sDelta(ST) and sAnyValid(R, ST)) or keriBadL(S, ST) .
  eq keriBadL(S, ST) = false [owise] .
  *** the same before that deadline: the watcher's sync latency of T2 and T18
  op keriRace : Conf -> Bool .
  eq keriRace(ST) = keriRaceL(ST, ST) .
  op keriRaceL : Conf Conf -> Bool .
  eq keriRaceL(reg(R, N, L, true, F2) S, ST) =
     (sNow(ST) <= sKeriTime(sAud(R, ST), ST) + sDelta(ST) and sAnyValid(R, ST)) or keriRaceL(S, ST) .
  eq keriRaceL(S, ST) = false [owise] .

  *** CR6: an accepted credential for which the allowlist views at registeredAt answer "not
  *** authorised", because the revocation or suspension came later in the same block
  op viewsBad : Conf -> Bool .
  eq viewsBad(ST) = viewsBadL(ST, ST) .
  op viewsBadL : Conf Conf -> Bool .
  eq viewsBadL(reg(R, N, L, F1, F2) S, ST) =
     (sEventIn(sAud(R, ST), sBody(R, ST), N, N, ST) and verdictCred(R, noRev, ST) =/= INVALID)
     or viewsBadL(S, ST) .
  eq viewsBadL(S, ST) = false [owise] .

  *** an impostor body's credential registered on-chain (attack 4: the contract accepts what a stolen
  *** owner key listed)
  op impostorRegistered : Conf -> Bool .
  eq impostorRegistered(ST) = impostorRegisteredL(ST, ST) .
  op impostorRegisteredL : Conf Conf -> Bool .
  eq impostorRegisteredL(reg(R, N, L, F1, F2) S, ST) =
     sRoot(sBody(R, ST), ST) =/= pinned or impostorRegisteredL(S, ST) .
  eq impostorRegisteredL(S, ST) = false [owise] .

  *** SUPERSEDED: a credential replaced by a revision at or before the latest block is not INVALID
  *** when presented alone (T4 (a))
  op supersededBad : Conf -> Bool .
  eq supersededBad(ST) = supersededBadL(ST, ST) .
  op supersededBadL : Conf Conf -> Bool .
  eq supersededBadL(supBy(R, R', T2) S, ST) = verdictCred(R, noRev, ST) =/= INVALID or supersededBadL(S, ST) .
  eq supersededBadL(S, ST) = false [owise] .

  *** --- non-vacuity witnesses: states the properties above must not rule out
  *** a downward revision by another body after the first body's suspension, with a batch claimed on
  *** the superseded credential still accepted by its importer at the latest block, and the revision
  *** itself accepted when presented alone
  op revWitness : Conf -> Bool .
  ceq revWitness(supBy(r1, r2, T2) claimed(r1, I0, Q0, T, AS) S) = true
    if verdictShip(r1, I0, Q0, noRev, r1, I0, Q0, T, supBy(r1, r2, T2) claimed(r1, I0, Q0, T, AS) S) =/= INVALID
       /\ verdictCred(r2, noRev, supBy(r1, r2, T2) claimed(r1, I0, Q0, T, AS) S) =/= INVALID .
  eq revWitness(S) = false [owise] .
  *** a credential registered after its auditor's ECR was revoked in KERI, CONTESTED at the latest block
  op contestedAfterKeri : Conf -> Bool .
  eq contestedAfterKeri(ST) = contestedAfterKeriL(ST, ST) .
  op contestedAfterKeriL : Conf Conf -> Bool .
  eq contestedAfterKeriL(reg(R, N, L, true, F2) S, ST) =
     verdictCred(R, noRev, ST) == CONTESTED or contestedAfterKeriL(S, ST) .
  eq contestedAfterKeriL(S, ST) = false [owise] .
  *** two batches of one credential claimed for two different importers, each accepted by its own
  *** importer (the shared cap is exercised across importers)
  op twoImporters : Conf -> Bool .
  ceq twoImporters(claimed(R, I, Q, T, ac(R, I, Q) ; AS) claimed(R, I', Q', T', ac(R, I', Q') ; AS') S) = true
    if I =/= I' .
  eq twoImporters(S) = false [owise] .
  *** a credential registered by b1 after its suspension was lifted, and accepted by an importer
  *** (regInactiveBad and authBad do not forbid registration after a lift)
  op regAfterLift : Conf -> Bool .
  ceq regAfterLift(susp(b1, E) lifted(b1, K) reg(R, N, L, F1, F2) claimed(R0, I0, Q0, T, ac(R, I, Q) ; AS) S) = true
    if E < N .
  eq regAfterLift(S) = false [owise] .

  *** every safety property expected to hold (under A-Watch for keriBad)
  op safetyBad : Conf -> Bool .
  eq safetyBad(ST) = p1Bad(ST) or ledgerBad(ST) or replayBad(ST) or authBad(ST) or regAfterRevBad(ST)
                     or regInactiveBad(ST) or foreignReviseBad(ST)
                     or evidenceBad(ST) or windowBad(ST) or supersededBad(ST) or keriBad(ST) .

  *** ------------------------------------------------------------ instances
  *** every instance: delta = 1 tick, three batches of 1 t, two importers, ticks 0..M
  op common : Nat -> Conf .
  eq common(M) = clock(0) tmax(M) delta(1) importer(i1) importer(i2) ship(1) ship(1) ship(1) .

  *** KERI: b1 (pinned root) and its auditor a1, whose ECR the body may revoke in KERI at any tick;
  *** b2 is an impostor body a stolen owner key listed (attack 4), with auditor a2; r1 by b1/a1 and
  *** r2 by b2/a2, 2 t each, in separate products; W is the watcher's behaviour
  op keriInst : WMode Nat -> Sys .
  eq keriInst(W, M) = { common(M) wmode(W) allowKeri(a1)
       slotLabel(X) slotLabel(Z) canReg(r1, X) canReg(r2, Z)
       body(b1, pinned, M) body(b2, other, M) aud(a1, b1) aud(a2, b2)
       cred(r1, b1, a1, 2, X, noRep) cred(r2, b2, a2, 2, Z, noRep) } .

  *** SUSPENSION: as KERI without the KERI revocation; the watcher may suspend b1 and lift it again,
  *** and suspend the impostor b2
  op suspInst : Nat -> Sys .
  eq suspInst(M) = { common(M) wmode(up) allowSuspend(b1) allowLift(b1) allowSuspend(b2)
       slotLabel(X) slotLabel(Z) canReg(r1, X) canReg(r2, Z)
       body(b1, pinned, M) body(b2, other, M) aud(a1, b1) aud(a2, b2)
       cred(r1, b1, a1, 2, X, noRep) cred(r2, b2, a2, 2, Z, noRep) } .

  *** REVISION: two accredited bodies; r2 by b2 revises b1's r1 downwards (2 t -> 1 t), which the
  *** contract allows only while b1 is inactive (suspended, or accreditation expired at tick 2) and
  *** only if 1 t covers the claimed quantity; the watcher may suspend b1 and lift it; claim times
  *** are recorded
  op revInst : Nat -> Sys .
  eq revInst(M) = { common(M) wmode(up) claimTimes allowSuspend(b1) allowLift(b1)
       slotLabel(X) canReg(r1, X)
       body(b1, pinned, 2) body(b2, pinned, M) aud(a1, b1) aud(a2, b2)
       cred(r1, b1, a1, 2, X, noRep) cred(r2, b2, a2, 1, X, r1) } .

  *** DUPLICATE: one body signs two credentials of 2 t for the same product; the second can be
  *** registered under the true slot (refused, CredScopeAlreadyCovered) or under another slot label,
  *** where it starts a ledger of its own (T19 (8))
  op dupInst : Nat -> Sys .
  eq dupInst(M) = { common(M) wmode(up)
       slotLabel(X) slotLabel(Y) canReg(r1, X) canReg(r2, X) canReg(r2, Y)
       body(b1, pinned, M) aud(a1, b1)
       cred(r1, b1, a1, 2, X, noRep) cred(r2, b1, a1, 2, X, noRep) } .

  *** FULL: the KERI and SUSPENSION instances together, with both auditors revocable in KERI
  op fullInst : WMode Nat -> Sys .
  eq fullInst(W, M) = { common(M) wmode(W) allowKeri(a1) allowKeri(a2)
       allowSuspend(b1) allowLift(b1) allowSuspend(b2)
       slotLabel(X) slotLabel(Z) canReg(r1, X) canReg(r2, Z)
       body(b1, pinned, M) body(b2, other, M) aud(a1, b1) aud(a2, b2)
       cred(r1, b1, a1, 2, X, noRep) cred(r2, b2, a2, 2, Z, noRep) } .

  *** change the CONTESTED window and watcher bound delta (in ticks) of an instance
  op _withDelta_ : Sys Nat -> Sys .
  eq { delta(D) S } withDelta N = { delta(N) S } .

  *** add a mutant to an instance
  op _+mut_ : Sys Mutant -> Sys .
  eq { S } +mut Mu = { S mut(Mu) } .
endm

*** LTL: propositions over the same states
mod CARBONLEI-LTL is
  protecting CARBONLEI .
  including MODEL-CHECKER .
  including LTL-SIMPLIFIER .
  subsort Sys < State .
  op keriRevokedP : Auditor -> Prop [ctor] .
  op chainRevokedP : Auditor -> Prop [ctor] .
  op validP : Report -> Prop [ctor] .
  op contestedP : Report -> Prop [ctor] .
  op safeP : -> Prop [ctor] .
  vars S : Conf . var A : Auditor . var R : Report .
  *** written with the spec helpers, like the properties
  eq { S } |= keriRevokedP(A) = sKeriRevokedNow(A, S) .
  eq { S } |= chainRevokedP(A) = sChainRevokedNow(A, S) .
  eq { S } |= validP(R) = verdictCred(R, noRev, S) == VALID .
  eq { S } |= contestedP(R) = verdictCred(R, noRev, S) == CONTESTED .
  eq { S } |= safeP = not safetyBad(S) .
endm

*** ================================================================================================
*** CR1: owner-key compromise, address rotation and report revocation (SECURITY §4.2 CR1, T10, §13.1)
***
*** A separate model, so the modules above and the commands that use them are unchanged. It keeps
*** only what CR1 is about: one body b1 with one honestly registered report r1, the body's address
*** and when it was bound, report revocation, and the rotation rules of the deployed contracts (V1:
*** rotateVerifierAddress takes effect at once) or of contracts/src/v2 (V2: proposeRotation, then
*** executeRotation after ROTATION_DELAY; revokeReport by an address bound less than REVOKE_HOLD ago
*** is queued, executeRevocation after REVOKE_HOLD only while the requester is still the body's
*** active address; cancelRotation by the body's current address or the WATCHER; cancelRevocation
*** by the WATCHER; suspendVerifier by the WATCHER).
***
*** The attacker holds the allowlist owner key and one fresh EVM key tk, never bound before. It does
*** not hold the body's key hk and cannot forge the body's EIP-712 consent, so the consent path
*** executeRotationSigned is closed to it and is not modelled. The honest owner, registration,
*** claims and the verifier are left out. One tick stands for 24 hours; both delays are 72 hours, 3
*** ticks. Every action can happen at any tick, in any order within a tick.
***
*** Monitoring is an assumption, stated as a constraint on time like A-Watch above: the clock may not
*** reach a deadline while the obligation is unmet. The actions that meet it (cancel, suspend) are
*** enabled whenever the obligation is pending, so the constraint never stops time by itself.
***   bmode(bWatch):    the body (or the watcher) cancels a pending rotation before readyAt.
***   wmon(wOnRotation): while the watcher holds its role, it suspends the body within REVOKE_HOLD
***                     of a rotation (VerifierAddressRotated).
***   wmon(wOnQueued):  the same, but only within REVOKE_HOLD of the first RevocationQueued.
***   bNone, wNone:     no obligation; the body and the watcher may still act at any time, or never.
*** With dropOK the owner key may also revoke the watcher's role (role changes are not delayed in
*** the contract unless the owner is a timelock); without it, it may not.

mod CARBONLEI-CR1 is
  protecting CARBONLEI-DATA .
  sorts Addr Holder Ver BMode WMon CrMutant CrFact CrConf CrSys .
  subsort CrFact < CrConf .
  *** hk: the body's own key, bound at tick 0; tk: the attacker's fresh key
  ops hk tk : -> Addr [ctor] .
  ops bodyKey thiefKey : -> Holder [ctor] .
  ops v1 v2 : -> Ver [ctor] .
  ops bWatch bNone : -> BMode [ctor] .
  ops wOnRotation wOnQueued wNone : -> WMon [ctor] .
  *** V2 mutants: noHold applies a revocation by a freshly bound address at once (REVOKE_HOLD
  *** removed); noLapse executes a queued revocation without checking that the requester is still
  *** the body's active address
  ops noHold noLapse : -> CrMutant [ctor] .
  op empty : -> CrConf [ctor] .
  op __ : CrConf CrConf -> CrConf [ctor assoc comm id: empty] .
  op {_} : CrConf -> CrSys [ctor] .

  op clock : Nat -> CrFact [ctor] .
  op tmax : Nat -> CrFact [ctor] .
  op ver : Ver -> CrFact [ctor] .
  op bmode : BMode -> CrFact [ctor] .
  op wmon : WMon -> CrFact [ctor] .
  op mut : CrMutant -> CrFact [ctor] .
  *** the owner key may revoke the watcher's role
  op dropOK : -> CrFact [ctor] .
  *** the WATCHER role is held by the watcher
  op watcher : -> CrFact [ctor] .
  *** who holds an EVM key (specification side only; the rules use attackerKey)
  op key : Addr Holder -> CrFact [ctor] .
  *** an address the attacker can sign with
  op attackerKey : Addr -> CrFact [ctor] .
  *** an address never bound to any body (the attacker's key, before the rotation)
  op fresh : Addr -> CrFact [ctor] .
  *** institutions[b].currentAddress and leiOfAddress[addr].boundAt
  op cur : Body Addr Nat -> CrFact [ctor] .
  *** a registered report and its issuing body
  op rep : Report Body -> CrFact [ctor] .
  op susp : Body -> CrFact [ctor] .
  *** pendingRotations[b] = (newAddr, readyAt)
  op prop : Body Addr Nat -> CrFact [ctor] .
  *** pendingRevocations[r] = (requester, readyAt)
  op queued : Report Addr Nat -> CrFact [ctor] .
  *** ReportRevoked(r, by, at)
  op revoked : Report Addr Nat -> CrFact [ctor] .
  *** events the monitors react to: VerifierAddressRotated (time), the first RevocationQueued (time)
  op rotated : Body Nat -> CrFact [ctor] .
  op firstQ : Body Nat -> CrFact [ctor] .
  *** ghost: a rotation proposal of this body was cancelled at least once
  op rcancel : Body Bool -> CrFact [ctor] .

  vars N M T K : Nat . var B : Body . vars A A' : Addr . var R : Report . vars S ST : CrConf .
  var V : Ver . var BM : BMode . var WM : WMon . var F : Bool . var Mu : CrMutant . var H : Holder .

  *** delays in ticks
  op delay : -> Nat .
  eq delay = 3 .
  op hold : -> Nat .
  eq hold = 3 .

  *** ------------------------------------------------------------ state queries (rules)
  op mutant : CrMutant CrConf -> Bool .
  eq mutant(Mu, mut(Mu) S) = true .
  eq mutant(Mu, S) = false [owise] .
  op isV1 : CrConf -> Bool .
  eq isV1(ver(v1) S) = true .
  eq isV1(S) = false [owise] .
  op isSusp : Body CrConf -> Bool .
  eq isSusp(B, susp(B) S) = true .
  eq isSusp(B, S) = false [owise] .
  op hasProp : Body CrConf -> Bool .
  eq hasProp(B, prop(B, A, T) S) = true .
  eq hasProp(B, S) = false [owise] .
  op isRevoked : Report CrConf -> Bool .
  eq isRevoked(R, revoked(R, A, T) S) = true .
  eq isRevoked(R, S) = false [owise] .
  op hasQueued : Report CrConf -> Bool .
  eq hasQueued(R, queued(R, A, T) S) = true .
  eq hasQueued(R, S) = false [owise] .
  op attackerHolds : Addr CrConf -> Bool .
  eq attackerHolds(A, attackerKey(A) S) = true .
  eq attackerHolds(A, S) = false [owise] .
  op hasWatcher : CrConf -> Bool .
  eq hasWatcher(watcher S) = true .
  eq hasWatcher(S) = false [owise] .
  *** isVerifierActiveAt(addr, now) and leiOfAddress(addr) == issuer: A is b's current address and
  *** b is not suspended (accreditation expiry is not modelled here)
  op activeAddr : Addr Body CrConf -> Bool .
  eq activeAddr(A, B, cur(B, A, T) S) = not isSusp(B, S) .
  eq activeAddr(A, B, S) = false [owise] .
  op clearQ : Report CrConf -> CrConf .
  eq clearQ(R, queued(R, A, T) S) = S .
  eq clearQ(R, S) = S [owise] .
  op markQ : Body Nat CrConf -> CrConf .
  eq markQ(B, N, firstQ(B, T) S) = firstQ(B, T) S .
  eq markQ(B, N, S) = S firstQ(B, N) [owise] .

  *** ------------------------------------------------------------ rules
  *** V1: rotateVerifierAddress with the stolen owner key, effective at once
  rl [v1-rotate] : { ver(v1) cur(B, A, T) fresh(A') clock(N) S }
    => { ver(v1) cur(B, A', N) clock(N) S rotated(B, N) } .

  *** V2: proposeRotation with the stolen owner key (one pending proposal per body; again after a
  *** cancellation)
  crl [propose] : { ver(v2) cur(B, A, T) fresh(A') clock(N) S }
    => { ver(v2) cur(B, A, T) fresh(A') clock(N) S prop(B, A', N + delay) }
    if not hasProp(B, S) .
  *** executeRotation: anyone, once readyAt has passed; the new address must still be unbound
  crl [exec-rotation] : { prop(B, A', T) cur(B, A, K) fresh(A') clock(N) S }
    => { cur(B, A', N) clock(N) S rotated(B, N) }
    if N >= T .
  *** cancelRotation by the body's current address (if the body still holds it) or the WATCHER
  crl [cancel-rotation] : { prop(B, A', T) cur(B, A, K) rcancel(B, F) S }
    => { cur(B, A, K) rcancel(B, true) S }
    if not attackerHolds(A, S) or hasWatcher(S) .

  *** revokeReport by an address the attacker holds, while it is the issuing body's active address.
  *** V1: applied at once. V2: applied at once if the address was bound at least REVOKE_HOLD ago,
  *** replacing a queued one; otherwise queued (RevocationQueued).
  crl [revoke-now] : { rep(R, B) cur(B, A, T) clock(N) S }
    => { rep(R, B) cur(B, A, T) clock(N) clearQ(R, S) revoked(R, A, N) }
    if attackerHolds(A, S) /\ not isRevoked(R, S) /\ not isSusp(B, S)
       /\ (isV1(S) or T + hold <= N or mutant(noHold, S)) .
  crl [revoke-queue] : { ver(v2) rep(R, B) cur(B, A, T) clock(N) S }
    => { ver(v2) rep(R, B) cur(B, A, T) clock(N) markQ(B, N, S) queued(R, A, N + hold) }
    if attackerHolds(A, S) /\ not isRevoked(R, S) /\ not isSusp(B, S) /\ not hasQueued(R, S)
       /\ N < T + hold /\ not mutant(noHold, S) .
  *** executeRevocation: anyone, REVOKE_HOLD after the request, if the requester is still the body's
  *** active address
  crl [exec-revocation] : { queued(R, A, T) rep(R, B) clock(N) S }
    => { rep(R, B) clock(N) S revoked(R, A, N) }
    if N >= T /\ not isRevoked(R, S) /\ (activeAddr(A, B, S) or mutant(noLapse, S)) .
  *** cancelRevocation by the WATCHER (the body's current address may cancel too, but after a hostile
  *** rotation that is the attacker's)
  rl [cancel-revocation] : { queued(R, A, T) watcher S } => { watcher S } .
  *** suspendVerifier by the WATCHER (not lifted within the bound)
  crl [suspend] : { watcher cur(B, A, T) S } => { watcher cur(B, A, T) S susp(B) }
    if not isSusp(B, S) .
  *** the owner key revokes the WATCHER role
  rl [drop-watcher] : { dropOK watcher S } => { S } .

  *** time advances, not past a deadline whose monitoring obligation is unmet
  crl [tick] : { clock(N) tmax(M) S } => { clock(s N) tmax(M) S }
    if N < M /\ bodyOK(s N, S, S) /\ watchOK(s N, S, S) .
  op bodyOK : Nat CrConf CrConf -> Bool .
  eq bodyOK(N, prop(B, A, T) S, bmode(bWatch) ST) = T > N and bodyOK(N, S, bmode(bWatch) ST) .
  eq bodyOK(N, S, ST) = true [owise] .
  op watchOK : Nat CrConf CrConf -> Bool .
  eq watchOK(N, rotated(B, K) S, wmon(wOnRotation) watcher ST) =
     (N < K + hold or isSusp(B, ST)) and watchOK(N, S, wmon(wOnRotation) watcher ST) .
  eq watchOK(N, firstQ(B, K) S, wmon(wOnQueued) watcher ST) =
     (N < K + hold or isSusp(B, ST)) and watchOK(N, S, wmon(wOnQueued) watcher ST) .
  eq watchOK(N, S, ST) = true [owise] .

  *** ------------------------------------------------------------ specification side
  *** written with their own helpers (prefixed s), from SECURITY §4.2 CR1 and §13.1
  op sIssuer : Report CrConf -> Body .
  eq sIssuer(R, rep(R, B) S) = B .
  op sHolder : Addr CrConf -> Holder .
  eq sHolder(A, key(A, H) S) = H .
  *** CR1: a report is revoked by an address its issuing body did not control
  op cr1Bad : CrConf -> Bool .
  eq cr1Bad(ST) = cr1BadL(ST, ST) .
  op cr1BadL : CrConf CrConf -> Bool .
  eq cr1BadL(revoked(R, A, N) S, ST) = sHolder(A, ST) =/= bodyKey or cr1BadL(S, ST) .
  eq cr1BadL(S, ST) = false [owise] .
  *** the same, at a tick before K
  op cr1BadBefore : Nat CrConf -> Bool .
  eq cr1BadBefore(K, ST) = cr1BeforeL(K, ST, ST) .
  op cr1BeforeL : Nat CrConf CrConf -> Bool .
  eq cr1BeforeL(K, revoked(R, A, N) S, ST) =
     (sHolder(A, ST) =/= bodyKey and N < K) or cr1BeforeL(K, S, ST) .
  eq cr1BeforeL(K, S, ST) = false [owise] .
  *** non-vacuity: a proposal was cancelled, nothing rotated, and time reached the bound
  op cancelWitness : CrConf -> Bool .
  ceq cancelWitness(rcancel(B, true) clock(M) tmax(M) S) = true
    if not sRotated(B, S) .
  eq cancelWitness(S) = false [owise] .
  op sRotated : Body CrConf -> Bool .
  eq sRotated(B, rotated(B, K) S) = true .
  eq sRotated(B, S) = false [owise] .
  *** non-vacuity: the rotation went through, the attacker's revocation is queued, the body is
  *** suspended, and time reached the bound
  op suspendWitness : CrConf -> Bool .
  eq suspendWitness(rotated(B, K) susp(B) queued(R, A, T) clock(M) tmax(M) S) = true .
  eq suspendWitness(S) = false [owise] .

  *** ------------------------------------------------------------ instance
  *** cr1Inst(contract version, body monitoring, watcher monitoring, owner key may drop the watcher,
  *** last tick)
  op cr1Inst : Ver BMode WMon Bool Nat -> CrSys .
  eq cr1Inst(V, BM, WM, F, M) =
     { clock(0) tmax(M) ver(V) bmode(BM) wmon(WM) watcher (if F then dropOK else empty fi)
       key(hk, bodyKey) key(tk, thiefKey) attackerKey(tk) fresh(tk)
       cur(b1, hk, 0) rep(r1, b1) rcancel(b1, false) } .
  op _+mut_ : CrSys CrMutant -> CrSys .
  eq { S } +mut Mu = { S mut(Mu) } .
endm
