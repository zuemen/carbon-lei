{
  "name": "carbon-lei",
  "private": true,
  "description": "Verified embedded-emissions credentials for CBAM supply chains, with a shared claimable-tonnage ledger on Sepolia.",
  "license": "MIT",
  "workspaces": [
    "sdk",
    "verifier",
    "demo"
  ],
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "contracts:test": "forge test",
    "contracts:deploy": "forge script contracts/script/Deploy.s.sol --rpc-url sepolia --broadcast --verify --verifier etherscan && node scripts/record-deployment.mjs 11155111",
    "carbonlei": "node sdk/cli.ts",
    "verify:demo": "node sdk/cli.ts verify --proof fixtures/sepolia-demo-proof.json --eori NLDEMO000000001",
    "verify:tampered": "node sdk/cli.ts verify --proof fixtures/sepolia-demo-proof.tampered.json --eori NLDEMO000000001 --expect-invalid DISCLOSURE_TAMPERED",
    "audit:onchain": "node scripts/audit-onchain.ts",
    "vlei:up": "npm run vlei:up -w verifier",
    "vlei:setup": "npm run vlei:setup -w verifier",
    "demo:local": "node scripts/demo-local.ts",
    "demo:scenario": "node scripts/demo-scenario.ts",
    "demo:data": "node scripts/build-demo-data.ts",
    "demo:sepolia": "node --env-file=.env scripts/demo-scenario.ts --network sepolia",
    "demo:data:sepolia": "node scripts/build-demo-data.ts --network sepolia",
    "vlei:watch": "npm run vlei:watch -w verifier --",
    "vlei:revoke": "npm run vlei:revoke -w verifier --",
    "vlei:watch:sepolia": "node --env-file=.env verifier/src/watch.ts --send",
    "vlei:impostor:setup": "npm run vlei:impostor:setup -w verifier",
    "vlei:impostor:export": "npm run vlei:impostor:export -w verifier",
    "vlei:impostor:anchor": "npm run vlei:impostor:anchor -w verifier --"
  },
  "type": "module"
}
