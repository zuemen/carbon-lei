{
  "name": "@carbon-lei/verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "scripts": {
    "vlei:up": "docker compose -f docker-compose.yaml -p carbonlei up -d --wait",
    "vlei:down": "docker compose -f docker-compose.yaml -p carbonlei down",
    "vlei:schema": "node scripts/build-schema.ts",
    "vlei:setup": "node src/setup.ts",
    "vlei:export": "node src/export-evidence.ts",
    "vlei:anchor": "node src/anchor.ts",
    "vlei:status": "node src/status.ts",
    "vlei:revoke": "node src/revoke-ecr.ts",
    "vlei:watch": "node src/watch.ts",
    "vlei:impostor:setup": "node src/setup-impostor.ts setup",
    "vlei:impostor:export": "node src/setup-impostor.ts export",
    "vlei:impostor:anchor": "node src/setup-impostor.ts anchor",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=\"src/**/*.ts\" --coverage.reporter=text --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "signify-ts": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.9.0"
  }
}
